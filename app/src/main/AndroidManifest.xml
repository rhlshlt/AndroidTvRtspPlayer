<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Runs on Android TV and Google TV; not required so it also installs on a phone for development. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".TvRtspApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvRtspPlayer">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Phase 0 test hook: lets adb add cameras without typing on the TV. Enabled only in the
            debug and perf builds (adbHookEnabled in app/build.gradle.kts). android.permission.DUMP
            is held by the adb shell but not by ordinary apps, so other apps on the TV can't send to
            it. Removed when Phase 1 adds encrypted storage.
        -->
        <receiver
            android:name=".debug.AdbCameraReceiver"
            android:enabled="${adbHookEnabled}"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.rhlshlt.tvrtsp.ADD_TAPO" />
                <action android:name="io.github.rhlshlt.tvrtsp.ADD_URL" />
                <action android:name="io.github.rhlshlt.tvrtsp.ADD_LAB" />
                <action android:name="io.github.rhlshlt.tvrtsp.CLEAR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
